generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  username      String
  email         String    @unique
  password      String?
  authProvider  String    @default("local")
  isVerified    Boolean   @default(false)
  isLoggedIn    Boolean   @default(false)
  token         String?
  otp           String?
  otpExpiry     DateTime?
  termsAccepted Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions         Session[]
  donations        Donation[]
  purchaseOrders   PurchaseOrder[]
  entitlements     NoteEntitlement[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OtpCode {
  id                  String    @id @default(cuid())
  email               String
  purpose             String
  codeHash            String
  expiresAt           DateTime
  attempts            Int       @default(0)
  maxAttempts         Int       @default(5)
  consumedAt          DateTime?
  lastSentAt          DateTime  @default(now())
  resendCount         Int       @default(0)
  resendWindowStart   DateTime  @default(now())
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([email, purpose])
  @@index([expiresAt])
}

model Donation {
  id                  String    @id @default(cuid())
  userId              String?
  razorpayOrderId     String    @unique
  razorpayPaymentId   String?   @unique
  amount              Int
  currency            String    @default("INR")
  status              String    @default("created")
  paymentMethod       String?
  webhookProcessedAt  DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model WebhookEvent {
  id              String    @id @default(cuid())
  razorpayEventId String    @unique
  eventType       String
  processed       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  processedAt     DateTime?
}

model PaidNoteConfig {
  id        String   @id @default(cuid())
  noteKey   String   @unique
  title     String
  price     Int
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders  PurchaseOrder[]
  entitlements    NoteEntitlement[]
}

model PurchaseOrder {
  id                String    @id @default(cuid())
  userId            String
  noteKey           String
  razorpayOrderId   String    @unique
  razorpayPaymentId String?   @unique
  amount            Int
  currency          String    @default("INR")
  status            String    @default("created")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  config PaidNoteConfig @relation(fields: [noteKey], references: [noteKey], onDelete: Cascade)
}

model NoteEntitlement {
  id        String   @id @default(cuid())
  userId    String
  noteKey   String
  createdAt DateTime @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  config           PaidNoteConfig    @relation(fields: [noteKey], references: [noteKey], onDelete: Cascade)
  registeredDevice RegisteredDevice?

  @@unique([userId, noteKey])
}

model RegisteredDevice {
  id            String   @id @default(cuid())
  entitlementId String   @unique
  fingerprint   String
  deviceToken   String   @unique @default(cuid())
  registeredAt  DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  resetAt       DateTime?

  entitlement NoteEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
}