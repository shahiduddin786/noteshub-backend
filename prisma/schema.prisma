generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  username      String
  email         String    @unique
  password      String?
  authProvider  String    @default("local")
  isVerified    Boolean   @default(false)
  isLoggedIn    Boolean   @default(false)
  token         String?
  otp           String?
  otpExpiry     DateTime?
  termsAccepted Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profilePhotoUrl      String?
  profilePhotoPublicId String?

  sessions         Session[]
  donations        Donation[]
  purchaseOrders   PurchaseOrder[]
  entitlements     NoteEntitlement[]
  recoveryRequests DeviceRecoveryRequest[]
  deviceAuthEvents DeviceAuthEvent[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OtpCode {
  id                  String    @id @default(cuid())
  email               String
  purpose             String
  codeHash            String
  expiresAt           DateTime
  attempts            Int       @default(0)
  maxAttempts         Int       @default(5)
  consumedAt          DateTime?
  lastSentAt          DateTime  @default(now())
  resendCount         Int       @default(0)
  resendWindowStart   DateTime  @default(now())
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([email, purpose])
  @@index([expiresAt])
}

model Donation {
  id                  String    @id @default(cuid())
  userId              String?
  razorpayOrderId     String    @unique
  razorpayPaymentId   String?   @unique
  amount              Int
  currency            String    @default("INR")
  status              String    @default("created")
  paymentMethod       String?
  webhookProcessedAt  DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model WebhookEvent {
  id              String    @id @default(cuid())
  razorpayEventId String    @unique
  eventType       String
  processed       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  processedAt     DateTime?
}

model PaidNoteConfig {
  id        String   @id @default(cuid())
  noteKey   String   @unique
  title     String
  price     Int
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders  PurchaseOrder[]
  entitlements    NoteEntitlement[]

  recoveryRequests DeviceRecoveryRequest[]
  deviceAuthEvents DeviceAuthEvent[]
}

model PurchaseOrder {
  id                String    @id @default(cuid())
  userId            String
  noteKey           String
  razorpayOrderId   String    @unique
  razorpayPaymentId String?   @unique
  amount            Int
  currency          String    @default("INR")
  status            String    @default("created")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  config PaidNoteConfig @relation(fields: [noteKey], references: [noteKey], onDelete: Cascade)

  recoveryRequests DeviceRecoveryRequest[]
}

model NoteEntitlement {
  id        String   @id @default(cuid())
  userId    String
  noteKey   String
  createdAt DateTime @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  config           PaidNoteConfig    @relation(fields: [noteKey], references: [noteKey], onDelete: Cascade)
  registeredDevice RegisteredDevice?

  @@unique([userId, noteKey])
}

model RegisteredDevice {
  id            String   @id @default(cuid())
  entitlementId String   @unique
  fingerprint   String
  deviceToken   String   @unique @default(cuid())
  registeredAt  DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  resetAt       DateTime?

  entitlement NoteEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
}

model DeviceRecoveryRequest {
  id                String    @id @default(cuid())
  userId            String
  noteKey           String
  purchaseOrderId   String?
  status            String    @default("PENDING")
  activeMarker      String?
  description       String
  userAgent         String?
  browserName       String?
  browserVersion    String?
  osName            String?
  osVersion         String?
  deviceFingerprint String?
  rejectionReason   String?
  resolvedBy        String?
  resolvedAt        DateTime?
  emailSentAt       DateTime?
  emailAttempts     Int       @default(0)
  emailLastError    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  config        PaidNoteConfig @relation(fields: [noteKey], references: [noteKey], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@unique([userId, noteKey, activeMarker])
  @@index([status, createdAt])
}

model DeviceAuthEvent {
  id            String   @id @default(cuid())
  userId        String
  noteKey       String?
  entitlementId String?
  eventType     String
  actor         String   @default("system")
  detail        String?
  userAgent     String?
  fingerprint   String?
  createdAt     DateTime @default(now())

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  config PaidNoteConfig? @relation(fields: [noteKey], references: [noteKey], onDelete: SetNull)

  @@index([userId, noteKey, createdAt])
}

model NoteAsset {
  id        String   @id
  provider  String
  publicId  String
  filename  String
  folder    String
  bytes     Int?
  version   String?
  hash      String?
  url       String?
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@unique([provider, publicId])
  @@index([folder])
}